# antwen music 配置。复制为 .env 后修改；服务端启动时自动读取。
# 下面的默认值就是「本地调试」：不登录、只监听本机、不走代理。

# ---- 服务 ----
PORT=5175
HOST=127.0.0.1
# 对外地址：OIDC 回调和 Cookie 的 Secure 看它。
# 本地调试填前端开发地址；线上填 https://music.antwen.cn
PUBLIC_URL=http://localhost:5173
# 数据目录：SQLite、已安装插件、插件数据
DATA_DIR=./data

# ---- 登录 ----
# none：不登录，打开就是管理员（只允许 HOST 为本机，除非设 ALLOW_OPEN_ACCESS=1）
# oidc：用主站 antwen 账号登录
AUTH_MODE=none
OIDC_ISSUER=https://www.antwen.cn
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# 白名单：主站用户的 sub、用户名或邮箱，逗号分隔；* 表示所有登录用户
ALLOWED_USERS=
# 管理员：可安装/删除插件、设置出网方式，写法同上
ADMIN_USERS=
# 主站管理员（可信应用下发的 is_admin）自动成为这里的管理员；设为 0 关闭
OIDC_SITE_ADMINS=1

# ---- 代理（都可选，留空就直连）----
# 国内代理：只有在设置里把插件的出网方式选成「经国内代理」才会用到。
# 本地调试时人就在国内，网易云直连即可，不用填。例：http://user:pass@1.2.3.4:8080
CN_PROXY_URL=
# 海外代理：插件出网方式选「经海外代理」时使用，比如在国内用 Spotify 时填本机 Clash http://127.0.0.1:7890
GLOBAL_PROXY_URL=
# 访问 GitHub 安装插件时用的代理，比如本机 Clash：http://127.0.0.1:7890
GITHUB_PROXY_URL=
# GitHub API 令牌，可选，避免安装插件时被限流
GITHUB_TOKEN=

# ---- 插件 ----
# 第一次启动时自动安装的插件（GitHub 仓库，逗号分隔）；装好后删掉也不会再装
DEFAULT_PLUGINS=AkinoKaede/mygo-music-netease-cloud-music
